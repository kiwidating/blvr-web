---
interface Props { secondary?: boolean; href?: string }
const { secondary = false, href = 'https://blvr.app' } = Astro.props;
---
<a class:list={['button', { secondary }]} href={href}>
  <slot />
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
</a>
